# commons-csv references a SpotBugs annotation that is not on the Android classpath.
-dontwarn edu.umd.cs.findbugs.annotations.SuppressFBWarnings

# R8 optimization of the Google code scanner library throws a NullPointerException at scan time.
-keep class com.google.mlkit.** { *; }
-keep class com.google.android.gms.internal.mlkit_** { *; }
